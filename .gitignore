# 默认排除，只有审查过的开发文件进入仓库。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/bridge/
/bridge/*
!/bridge/package.json
!/bridge/package-lock.json
!/bridge/manifest.json
!/bridge/src/
/bridge/src/*
!/bridge/src/*.mjs
!/bridge/scripts/
/bridge/scripts/*
!/bridge/scripts/*.mjs
!/bridge/scripts/*.ps1
!/tests/
/tests/*
!/tests/*.mjs
!/scripts/
/scripts/*
!/scripts/*.mjs

# 运行数据、个人配置、方法文档和真实客户端证据留在本地。
**/node_modules/
**/runtime/
**/.npm-cache/
**/logs/
**/artifacts/
**/docs/
**/tasks/
**/.env
**/.env.*
**/*.local.*
**/*private*
**/*secret*
**/*credentials*
**/auth.json
**/*.sqlite*
**/*.db
**/*.dpapi
**/*.mcpb
**/*.log
**/*-key.txt
**/claude_desktop_config.json
